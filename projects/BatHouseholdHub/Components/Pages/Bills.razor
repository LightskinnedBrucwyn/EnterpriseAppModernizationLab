@page "/bills"
@inject CashflowService Cashflow

@* The page is a thin coordinator: it owns the tab strip, the shared "can we afford it?"
   pulse, and the toast. Each tab's markup and logic lives in its own component under
   Components/Bills. Inactive tabs stay rendered but hidden so filters, drafts, and
   half-filled forms survive switching tabs, exactly as they did when this was one file. *@

<PageTitle>Bills & Money</PageTitle>
<section class="page-heading">
    <div><span class="kicker">BILLS &amp; MONEY</span><h1>Bills and cashflow</h1><p>What we have, what's due, what's left, and everything that moved through the accounts. Check <a href="calendar">the calendar</a> for due dates laid out across the month.</p></div>
    @if (Tab == "Overview" || Tab == "Bills")
    { <button class="button primary" @onclick="OpenAddBill">＋ Add bill</button> }
    else if (Tab == "Transactions")
    { <button class="button primary" @onclick="() => ShowTxForm = true">＋ Add transaction</button> }
</section>

<div class="food-tabs">
    <button class="@(Tab == "Overview" ? "active" : "")" @onclick='() => Tab = "Overview"'>Overview</button>
    <button class="@(Tab == "Bills" ? "active" : "")" @onclick='() => Tab = "Bills"'>Bills</button>
    <button class="@(Tab == "Income" ? "active" : "")" @onclick='() => Tab = "Income"'>Income</button>
    <button class="@(Tab == "Transactions" ? "active" : "")" @onclick='() => Tab = "Transactions"'>Transactions</button>
</div>

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="success-toast">✓ @StatusMessage @if (UndoAction is not null) { <button class="undo-button" @onclick="RunUndo">Undo</button> }</div>
}

<section class="panel money-pulse @PulseClass">
    <div class="panel-head">
        <div><span class="kicker">CAN WE AFFORD IT?</span><h2>@PulseHeadline</h2><p class="muted">@PulseDetail</p></div>
        <b>@Summary.AmountLeftAfterBuffer.ToString("C")</b>
    </div>
    @if (Summary.BillsDueThisWeek > 0)
    {
        <p class="due-soon">⏰ @Summary.BillsDueThisWeek.ToString("C") in bills due this week@(Summary.BillsDueThisMonth > Summary.BillsDueThisWeek ? $" · {Summary.BillsDueThisMonth:C} by month's end" : "")</p>
    }
</section>

<div style="@TabStyle("Overview")">
    <BillsOverviewTab @bind-Window="SelectedWindow" @bind-CustomDate="CustomDate" Notify="ShowToast" OnEditBill="EditBillFromOverview" OnSeeAllBills='() => Tab = "Bills"' />
</div>
<div style="@TabStyle("Bills")">
    <BillsListTab @bind-ShowForm="ShowBillForm" EditRequest="PendingEdit" EditRequestHandled="() => PendingEdit = null" Notify="ShowToast" />
</div>
<div style="@TabStyle("Income")">
    <IncomeTab Notify="ShowToast" />
</div>
<div style="@TabStyle("Transactions")">
    <TransactionsTab @bind-ShowForm="ShowTxForm" Notify="ShowToast" />
</div>

@code {
    string Tab = "Overview";
    string StatusMessage = "";
    Func<Task>? UndoAction;
    bool ShowBillForm, ShowTxForm;
    Bill? PendingEdit;
    CashflowWindow SelectedWindow = CashflowWindow.UntilNextPaycheck;
    DateTime CustomDate = DateTime.Today;

    string? TabStyle(string tab) => Tab == tab ? null : "display:none";

    CashflowSummary Summary => Cashflow.BuildSummary(SelectedWindow, CustomDate);
    string PulseClass => Summary.AmountLeftAfterBuffer < 0 ? "pulse-over" : Summary.AmountLeftAfterBuffer < 150 ? "pulse-tight" : "pulse-healthy";
    string PulseHeadline => Summary.AmountLeftAfterBuffer < 0
        ? $"Short by {Math.Abs(Summary.AmountLeftAfterBuffer):C} before {Summary.SelectedDate:MMM d}"
        : Summary.AmountLeftAfterBuffer < 150
            ? $"Tight — {Summary.AmountLeftAfterBuffer:C} left before {Summary.SelectedDate:MMM d}"
            : $"Safe to spend {Summary.AmountLeftAfterBuffer:C} before {Summary.SelectedDate:MMM d}";
    string PulseDetail => $"After {(Summary.UpcomingBillsBeforeSelectedDate + Summary.RequiredDebtPaymentsBeforeSelectedDate + Summary.PendingPayments + Summary.ReservedMoney):C} in bills and holds, plus a {Summary.BufferAmount:C} buffer kept aside" +
        (Summary.NextPaycheck is { } np ? $" — next paycheck {np.NetAmount:C} expected {np.ExpectedDate:MMM d}." : ".");

    void ShowToast(Toast toast)
    {
        StatusMessage = toast.Message;
        UndoAction = toast.Undo;
    }

    async Task RunUndo()
    {
        if (UndoAction is not null) await UndoAction();
        StatusMessage = "";
        UndoAction = null;
    }

    void OpenAddBill()
    {
        // From Overview the old page armed an invisible form; now it jumps to the Bills
        // tab so the form actually appears.
        if (Tab != "Bills") { Tab = "Bills"; ShowBillForm = true; }
        else ShowBillForm = !ShowBillForm;
    }

    void EditBillFromOverview(Bill bill)
    {
        Tab = "Bills";
        PendingEdit = bill;
    }
}
