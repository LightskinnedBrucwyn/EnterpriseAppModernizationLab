@page "/groceries-tracker"
@inject HouseholdStore Store

<PageTitle>Groceries Tracker</PageTitle>
<section class="page-heading"><div><span class="kicker">WHAT'S FOR DINNER?</span><h1>Groceries tracker</h1><p>Plan the week, keep favorite recipes, and carry one tidy list to the store.</p></div><div class="button-group"><button class="button magic" @onclick="AutoPlanWeek">✦ Plan my week</button><button class="button primary" @onclick="() => ShowRecipe = !ShowRecipe">＋ New recipe</button></div></section>

@if (!string.IsNullOrWhiteSpace(StatusMessage)) { <div class="success-toast">✓ @StatusMessage</div> }

<div class="food-tabs"><button class="@(Tab == "week" ? "active" : "")" @onclick="ShowWeek">This week</button><button class="@(Tab == "groceries" ? "active" : "")" @onclick="ShowGroceries">Grocery list</button><button class="@(Tab == "recipes" ? "active" : "")" @onclick="ShowRecipes">Recipes</button></div>

@if (ShowRecipe)
{
    <section class="panel form-panel"><div class="panel-head"><h2>Save a recipe</h2><button class="icon-button" @onclick="() => ShowRecipe = false">×</button></div><div class="form-grid">
        <label>Recipe name<input @bind="RecipeDraft.Name" /></label><label>Type<select @bind="RecipeDraft.Category"><option>Breakfast</option><option>Lunch</option><option>Dinner</option><option>Treat</option></select></label>
        <label>Minutes<input type="number" @bind="RecipeDraft.Minutes" /></label><label class="wide">Ingredients, one per line<textarea @bind="RecipeDraft.Ingredients"></textarea></label><label class="wide">Instructions<textarea @bind="RecipeDraft.Instructions"></textarea></label>
    </div><button class="button primary" @onclick="AddRecipe" disabled="@(string.IsNullOrWhiteSpace(RecipeDraft.Name))">Save recipe</button></section>
}

@if (Tab == "week")
{
    <section class="week-grid">
    @foreach (var day in Enumerable.Range(0, 7).Select(i => StartOfWeek.AddDays(i)))
    {
        var plan = Store.Data.MealPlans.FirstOrDefault(x => x.Date.Date == day.Date);
        <article class="day-card @(day.Date == DateTime.Today ? "today" : "")"><span>@day.ToString("ddd")</span><strong>@day.Day</strong><select value="@(plan?.Meal ?? "")" @onchange="@(e => SetMeal(day, e.Value?.ToString() ?? string.Empty))"><option value="">Choose dinner…</option>@foreach (var r in Store.Data.Recipes) { <option value="@r.Name">@r.Name</option> }</select></article>
    }
    </section>
}
else if (Tab == "groceries")
{
    <section class="panel grocery-panel"><div class="quick-add"><input @bind="GroceryName" @bind:event="oninput" placeholder="Add milk, apples, snacks…" /><select @bind="GrocerySection"><option>Produce</option><option>Meat</option><option>Pantry</option><option>Dairy</option><option>Frozen</option><option>Other</option></select><button class="button primary" @onclick="AddGrocery" disabled="@(string.IsNullOrWhiteSpace(GroceryName))">Add</button></div>
        @if (FrequentSuggestions.Any())
        {
            <div class="grocery-suggest"><small class="muted">Usually buy:</small>@foreach (var name in FrequentSuggestions) { <button @key="name" @onclick="() => QuickReAdd(name)">＋ @name</button> }</div>
        }
        @foreach (var group in Store.Data.Groceries.OrderBy(x => x.IsChecked).GroupBy(x => x.Section))
        { <h3 class="list-heading" @key="group.Key">@group.Key</h3>@foreach (var item in group) { <label class="grocery-row checked-@item.IsChecked.ToString().ToLower()" @key="item.Id"><input type="checkbox" checked="@item.IsChecked" @onchange="() => ToggleGrocery(item)" /><span>@item.Name</span><button @onclick="() => DeleteGrocery(item)">×</button></label> } }
        @if (Store.Data.Groceries.Any(x => x.IsChecked))
        {
            <div class="form-actions" style="margin-top:14px"><button class="button magic small" @onclick="ClearChecked">Clear @Store.Data.Groceries.Count(x => x.IsChecked) checked-off item(s)</button></div>
        }
    </section>
}
else
{
    <section class="recipe-grid">@foreach (var recipe in Store.Data.Recipes) { <article class="recipe-card panel" @key="recipe.Id"><span class="recipe-art">@RecipeEmoji(recipe.Category)</span><div><span class="kicker">@recipe.Category · @recipe.Minutes MIN</span><h2>@recipe.Name</h2><p>@IngredientCount(recipe) ingredients</p><button class="text-button" @onclick="() => AddIngredients(recipe)">＋ Add ingredients to list</button></div></article> }</section>
}

@code {
    string Tab = "week", GroceryName = "", GrocerySection = "Produce", StatusMessage = ""; bool ShowRecipe; Recipe RecipeDraft = new();
    void ShowWeek() => Tab = "week";
    void ShowGroceries() => Tab = "groceries";
    void ShowRecipes() => Tab = "recipes";
    DateTime StartOfWeek => DateTime.Today.AddDays(-((7 + (int)DateTime.Today.DayOfWeek - (int)DayOfWeek.Monday) % 7));
    async Task AddRecipe() { Store.Data.Recipes.Add(RecipeDraft); await Store.SaveAsync(); RecipeDraft = new(); ShowRecipe = false; Tab = "recipes"; }
    async Task AddGrocery() { AddToList(GroceryName.Trim(), GrocerySection); GroceryName = ""; await Store.SaveAsync(); }
    async Task ToggleGrocery(GroceryItem item) { item.IsChecked = !item.IsChecked; await Store.SaveAsync(); }
    async Task DeleteGrocery(GroceryItem item) { Store.Data.Groceries.Remove(item); await Store.SaveAsync(); }
    async Task ClearChecked() { Store.Data.Groceries.RemoveAll(x => x.IsChecked); await Store.SaveAsync(); StatusMessage = "Cleared the checked-off items — nice haul."; }
    async Task SetMeal(DateTime day, string meal) { var p = Store.Data.MealPlans.FirstOrDefault(x => x.Date.Date == day.Date); if (p is null) Store.Data.MealPlans.Add(new() { Date = day, Meal = meal }); else p.Meal = meal; await Store.SaveAsync(); }
    async Task AddIngredients(Recipe recipe) { foreach (var name in IngredientLines(recipe)) AddToList(name, GuessSection(name)); await Store.SaveAsync(); Tab = "groceries"; }
    async Task QuickReAdd(string name) { AddToList(name, GuessSection(name)); await Store.SaveAsync(); }

    /// <summary>Single entry point onto the grocery list: dedups by name, remembers the name
    /// in history (capped) so frequent buys can be re-added with one tap.</summary>
    void AddToList(string name, string section)
    {
        if (string.IsNullOrWhiteSpace(name)) return;
        Store.Data.GroceryHistory.Add(name);
        if (Store.Data.GroceryHistory.Count > 500) Store.Data.GroceryHistory.RemoveRange(0, Store.Data.GroceryHistory.Count - 500);
        if (!Store.Data.Groceries.Any(x => x.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
            Store.Data.Groceries.Add(new() { Name = name, Section = section });
    }

    IEnumerable<string> FrequentSuggestions => Store.Data.GroceryHistory
        .GroupBy(x => x, StringComparer.OrdinalIgnoreCase)
        .Where(g => g.Count() >= 2 && !Store.Data.Groceries.Any(x => x.Name.Equals(g.Key, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(g => g.Count())
        .Take(8)
        .Select(g => g.Key);

    static IEnumerable<string> IngredientLines(Recipe recipe) => recipe.Ingredients.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    static int IngredientCount(Recipe recipe) => IngredientLines(recipe).Count();
    static string RecipeEmoji(string category) => category switch { "Breakfast" => "☕", "Lunch" => "🥪", "Treat" => "🍰", _ => "🍲" };
    async Task AutoPlanWeek()
    {
        var recipes = Store.Data.Recipes.Where(x => x.Category == "Dinner").OrderBy(_ => Random.Shared.Next()).ToList();
        if (recipes.Count == 0) { StatusMessage = "Add one dinner recipe first, then I can plan the week."; return; }
        Store.Data.MealPlans.RemoveAll(x => x.Date.Date >= StartOfWeek && x.Date.Date < StartOfWeek.AddDays(7));
        for (var i = 0; i < 7; i++)
        {
            var recipe = recipes[i % recipes.Count];
            Store.Data.MealPlans.Add(new() { Date = StartOfWeek.AddDays(i), Meal = recipe.Name });
            foreach (var ingredient in IngredientLines(recipe)) AddToList(ingredient, GuessSection(ingredient));
        }
        await Store.SaveAsync();
        StatusMessage = "The week is planned and missing ingredients are on the grocery list.";
    }
    static string GuessSection(string item) => item.ToLowerInvariant() switch
    {
        var x when new[] { "broccoli", "lemon", "lime", "tomato", "avocado", "fruit", "onion", "garlic", "pepper", "lettuce", "spinach", "banana", "apple", "berr", "cucumber", "carrot", "celery", "cilantro", "potato" }.Any(x.Contains) => "Produce",
        var x when new[] { "chicken", "turkey", "beef", "pork", "sausage", "bacon", "fish", "salmon", "shrimp", "steak", "ground" }.Any(x.Contains) => "Meat",
        var x when new[] { "egg", "parmesan", "cheese", "milk", "butter", "yogurt", "cream" }.Any(x.Contains) => "Dairy",
        var x when x.Contains("frozen") => "Frozen",
        _ => "Pantry"
    };
}
